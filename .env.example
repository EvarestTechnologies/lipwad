# Copy to .env and fill in. Never commit .env.

# Models — stub serves fixtures (tests/CI); live calls the providers below
MODEL_PROVIDER_MODE=live   # live | stub

# Meta Model API (SAM 3.1, Muse Spark, Muse Voice Transcribe, fallback for every role)
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# Baseten — Muse Spark Open (reasoning loop)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Modal — Muse Glimmer endpoint (triage, batch)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_GLIMMER_ENDPOINT_URL=
MODAL_GLIMMER_MODEL=muse-glimmer

# Fireworks — fine-tuned coding model
FIREWORKS_API_KEY=
FIREWORKS_CODING_MODEL=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# DHA HIE
HIE_MODE=mock            # mock | sandbox
HIE_BASE_URL=
HIE_CLIENT_ID=
HIE_CLIENT_SECRET=

# App
DATABASE_URL=sqlite:///./lipwad.db
UPLOAD_DIR=./uploads
